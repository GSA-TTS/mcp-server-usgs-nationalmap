# Credentials for the Phoenix evaluation harness (eval/phoenix) and, if used,
# the MCP server. Copy this file to `.env` at the repo root and fill in values.
# The `.env` file is gitignored — never commit real secrets.

# USAi model gateway used by the eval agent and the LLM-as-judge evaluators.
USAI_API_KEY="your USAi API key here"
USAI_BASE_URL="https://your-usai-gateway-base-url"

# Model id the eval agent drives (e.g. claude_4_5_sonnet).
AGENT_MODEL="claude_4_5_sonnet"

# Model id the judge agent drives (e.g. claude_4_6_sonnet).
JUDGE_MODEL="claude_4_6_sonnet" 

# NOTE: The hydro_mcp server itself needs no credentials — the USGS NHDPlus HR
# service is public. These variables are only required to run the evaluations.
